[Unit]
Description=Research collector: CFTC R4 outcome maturer (daily)
Wants=network-online.target
After=network-online.target
After=research-cftc-collect.service

[Service]
Type=oneshot
WorkingDirectory=/opt/market-bot
ExecStart=/usr/bin/python3 scripts/analytics/research_collectors_run.py --job cftc-outcomes --timeout 600
TimeoutStartSec=650
StandardOutput=journal
StandardError=journal
