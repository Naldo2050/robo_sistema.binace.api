# =============================================================================
# .env.example - Template de variáveis de ambiente para Cloud & Docker
# Copie este arquivo para .env e preencha com suas configurações/credenciais.
# NUNCA commite o arquivo .env com credenciais reais!
# =============================================================================

# ===== Binance API =====
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ===== AI / LLM Providers =====
GROQ_API_KEY=your_groq_api_key_here
# OpenAI (opcional, alternativa ao Groq)
OPENAI_API_KEY=your_openai_api_key_here

# ===== Dados de Mercado & Macro =====
# Alpha Vantage (dados de mercado / candles / indicadores)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
# FRED API (dados macroeconômicos federais)
FRED_API_KEY=your_fred_api_key_here

# ===== DOCKER & SISTEMA OPERACIONAL (OCI Hardening) =====
# Usuário e grupo non-root dentro do container (deve bater com UID/GID do host se volumes locais forem usados)
APP_UID=1000
APP_GID=1000
# Timezone padrão institucional do container (deve ser UTC)
TZ=UTC
# Porta de exportação de métricas Prometheus e endpoint /health
PROMETHEUS_PORT=8000
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Formato de log (json ou text)
LOG_FORMAT=json

# ===== CLOUD FEATURE FLAGS (Defaults seguros: 0 = OFF) =====

# Semantic LLM Payload v3 (P2-F2 / P2-F2.1: payload compacto com contratos explícitos e sem alucinação)
LLM_SEMANTIC_PAYLOAD_V3_ENABLED=0

# Shadow Effort/Response Dataset v1 (P1-F / C1: gravação não-bloqueante de janelas e resolução de outcomes)
EFFORT_RESPONSE_SHADOW_ENABLED=0
EFFORT_RESPONSE_SHADOW_QUEUE_CAPACITY=1000
EFFORT_RESPONSE_SHADOW_FILEPATH=dados/datasets/shadow_effort_response.jsonl

# Binance USD-M Liquidation Telemetry Stream (P2-D1 / P2-D2 / C1: conexão dedicada forceOrder non-voting)
BINANCE_LIQUIDATION_STREAM_ENABLED=0

# CFTC Commitments of Traders Context (P6: dados contextuais semanais non-voting)
ENABLE_CFTC_COT_CONTEXT=0

# Modelos Quantitativos / ML (C1: modelos em volume read-only montado externamente)
ML_MODELS_PATH_HOST=./ml/models
ML_MODELS_DIR=ml/models

# Auditoria Forense Observacional (captura raw WebSocket para depuração temporal)
FORENSIC_CAPTURE=0

# Política de Carregamento de Ambiente (0 = ignora .env e usa apenas vars injetadas pelo container)
LOAD_DOTENV=1
